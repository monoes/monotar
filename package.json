{
  "name": "monotar",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "monoes:register": "tsx scripts/register-monoes-client.ts",
    "monoes:check": "tsx scripts/check-monoes-oauth.ts",
    "security:scan-bundle": "tsx scripts/scan-bundle-for-secrets.ts"
  },
  "devDependencies": {
    "eslint": "^9.13.0",
    "@eslint/js": "^9.13.0",
    "typescript-eslint": "^8.12.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "tsx": "^4.19.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma"]
  }
}
